{
  "name": "@opushr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:cron": "node dist/cron/scheduler.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:push": "node -e \"console.error('db:push is disabled: this project applies schema changes only through reviewed migration files. Write a hand-authored migration instead.'); process.exit(1)\"",
    "db:seed": "tsx --env-file ../../.env src/db/seed.ts",
    "db:seed-demo": "tsx --env-file ../../.env src/scripts/demo-data.ts",
    "db:reset-demo": "tsx --env-file ../../.env src/scripts/demo-data.ts --reset",
    "db:seed-projects": "tsx --env-file ../../.env src/db/seed-projects.ts",
    "backup": "tsx --env-file ../../.env src/jobs/backup.ts",
    "backup:prod": "node dist/jobs/backup.js",
    "restore": "tsx --env-file ../../.env src/jobs/restore.ts",
    "build:prod": "node scripts/build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@opushr/shared": "*",
    "@sentry/node": "^10.58.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.6.0",
    "hono-rate-limiter": "^0.4.0",
    "jose": "^5.9.0",
    "otplib": "^13.4.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.4",
    "resend": "^4.0.0",
    "sanitize-html": "^2.17.4",
    "svix": "^1.95.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.28.0",
    "esbuild": "^0.25.0",
    "fast-check": "^4.8.0",
    "msw": "^2.14.6",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  }
}
