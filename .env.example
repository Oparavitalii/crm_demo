# Copy to .env and adjust. Every value here is a placeholder — never commit .env.
# Defaults below match docker-compose.yml, so `docker compose up -d` + this file
# is enough to run the demo locally.

NODE_ENV=development
PORT=8080

# PostgreSQL. DATABASE_URL is used by the app pool, DATABASE_URL_DIRECT by
# migrations / backups (on Neon these differ: pooler vs direct host).
DATABASE_URL=postgres://opushr:opushr@localhost:5432/opushr
DATABASE_URL_DIRECT=postgres://opushr:opushr@localhost:5432/opushr

# JWT signing keys, at least 32 characters each. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-32-chars

CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# --- Public demo -------------------------------------------------------------
# true = e-mail / SMS / file storage are local no-ops, account-security
# endpoints are blocked for the shared guest login, nightly data reset.
DEMO_MODE=true
DEMO_USER_EMAIL=demo@opus-demo.example
DEMO_USER_PASSWORD=demo-opus-2026

# --- Only needed when DEMO_MODE=false ----------------------------------------
# S3-compatible object storage (Cloudflare R2 in production).
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ACCESS_KEY=<access-key-id>
# R2_SECRET_KEY=<secret-access-key>
# R2_BUCKET=<bucket-name>
# R2_REGION=auto

# E-mail via Resend (skipped automatically in development and demo mode).
# RESEND_API_KEY=<resend-api-key>
# RESEND_WEBHOOK_SECRET=<svix-signing-secret>
# EMAIL_FROM=onboarding@resend.dev

# SMS via SMSAPI.pl (off unless SMS_ENABLED=true; test mode on by default).
# SMSAPI_TOKEN=<oauth-token>
# SMS_ENABLED=false
# SMS_TEST_MODE=true

# First admin for a non-demo database (npm run db:seed -w @opushr/api).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<at-least-12-characters>

# Daily encrypted backup job: 64 hex chars (32 bytes, AES-256-GCM).
# BACKUP_ENCRYPTION_KEY=<64-hex-chars>

# Optional error tracking.
# SENTRY_DSN_API=<dsn>
